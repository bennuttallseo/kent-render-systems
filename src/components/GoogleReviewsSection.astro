---
interface Props {
  id?: string;
  variant?: "default" | "blue";
  lead?: string;
}

const {
  id,
  variant = "default",
  lead = "We are proud of the work we do and the reputation we have built with our clients and homeowners across Kent. Read what our customers say about our services and the finish they got.",
} = Astro.props;

const sectionClass = variant === "blue" ? "section reviews-bar" : "section";
---

<section class={sectionClass} id={id}>
  <div class="container">
    <div class="section-head center">
      <p class="eyebrow">Testimonials</p>
      <h2>What our customers say</h2>
      <p class="lead">{lead}</p>
    </div>
    <div class="reviews-widget">
      <div
        class="elfsight-app-9ee6fcf3-c509-4526-a426-d2fcf06c8bb6"
        data-elfsight-app-lazy
      ></div>
    </div>
  </div>
</section>

<script is:inline src="https://elfsightcdn.com/platform.js" async></script>

<style>
  .reviews-bar {
    background:
      radial-gradient(900px 420px at 15% 0%, rgba(30, 91, 184, 0.42), transparent 60%),
      linear-gradient(150deg, #15203b, #1d2c50);
  }
  .reviews-bar .eyebrow {
    color: var(--gold);
  }
  .reviews-bar h2 {
    color: #fff;
  }
  .reviews-bar .lead {
    color: #c7d0da;
  }
  .reviews-widget {
    margin-top: 8px;
  }
</style>
