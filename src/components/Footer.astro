---
import { serviceLinks } from "../data/serviceLinks";
import { footerAreaLinks } from "../data/locationHub";
import { projects, projectsHubPath } from "../data/projects";

interface Props {
  phone: string;
  phoneHref: string;
  email: string;
}
const { phone, phoneHref, email } = Astro.props;
const year = new Date().getFullYear();

const services = [
  ...serviceLinks.map((s) => ({ label: s.label.replace(" Kent", ""), href: s.href })),
  { label: "Lime Render", href: "/#lime" },
  { label: "External Wall Insulation", href: "/#ewi" },
];
const areas = footerAreaLinks;

const socialLinks = [
  {
    label: "Facebook",
    href: "https://www.facebook.com/jtplasteringkent.co.uk",
    icon: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  },
  {
    label: "TikTok",
    href: "https://www.tiktok.com/@kent.render.system",
    icon: '<path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>',
  },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="brand">
        <span class="brand-mark">
          <img src="/logo-mark.png" alt="" width="40" height="40" />
        </span>
        <strong>Kent Render Systems</strong>
      </div>
      <p>
        Specialist external rendering across Kent, <a href="/silicone-rendering-kent">silicone</a> and <a href="/monocouche-rendering-kent">monocouche</a>
        systems applied by a time-served installer with nearly 20 years'
        experience.
      </p>
      <p class="badges">Baumit · Weber · EcoRend Approved · EWI Accredited</p>
    </div>

    <div class="footer-col">
      <h4>Services</h4>
      <ul>{services.map((s) => <li>{s.href ? <a href={s.href}>{s.label}</a> : s.label}</li>)}</ul>
    </div>

    <div class="footer-col">
      <h4>Projects</h4>
      <ul>
        {projects.map((p) => (
          <li><a href={p.href}>{p.footerLabel}</a></li>
        ))}
      </ul>
      <a class="footer-areas-more" href={projectsHubPath}>View all projects &rarr;</a>
    </div>

    <div class="footer-col">
      <h4>Areas We Cover</h4>
      <ul>{areas.map((a) => <li>{a.href ? <a href={a.href}>{a.label}</a> : a.label}</li>)}</ul>
      <a class="footer-areas-more" href="/areas-we-cover">View all areas &rarr;</a>
    </div>

    <div class="footer-col">
      <h4>Get In Touch</h4>
      <ul class="contact">
        <li><a href={phoneHref}>{phone}</a></li>
        <li><a href={`mailto:${email}`}>{email}</a></li>
      </ul>
      <a class="btn btn--sm" href="/contact">Get Your Free Quote</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} Kent Render Systems. All rights reserved.</p>
    <ul class="footer-social">
      {socialLinks.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
            <span>{s.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="footer-credit">
      Created by <a href="https://eastkentseo.com/" target="_blank" rel="noopener noreferrer">East Kent SEO</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--charcoal);
    color: #aeb8c4;
    padding-top: 64px;
    font-size: 0.95rem;
  }
  .footer-grid {
    display: grid;
    gap: 36px;
    padding-bottom: 48px;
  }
  @media (min-width: 1100px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr 1.2fr;
      gap: 32px;
    }
  }
  @media (min-width: 760px) and (max-width: 1099px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  .footer-brand p {
    max-width: 38ch;
  }
  .footer-brand a {
    color: #d8dee6;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer-brand a:hover {
    color: var(--gold);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .brand-mark {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: #fff;
    flex: none;
  }
  .brand-mark img {
    width: 38px;
    height: 38px;
    object-fit: contain;
  }
  .brand strong {
    font-family: var(--font-display);
    color: #fff;
    font-size: 1.1rem;
  }
  .badges {
    color: var(--gold);
    font-size: 0.82rem;
    font-weight: 500;
  }
  .footer-col h4 {
    color: #fff;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .footer-col ul {
    display: grid;
    gap: 10px;
  }
  .footer-col a:hover {
    color: var(--gold);
  }
  .footer-areas-more {
    display: inline-block;
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--gold);
    text-decoration: none;
  }
  .footer-areas-more:hover {
    color: #fff;
  }
  .contact a {
    font-weight: 600;
    color: #d8dee6;
  }
  .footer-col .btn {
    margin-top: 18px;
  }
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-block: 22px;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    justify-items: center;
    gap: 16px;
    font-size: 0.85rem;
    color: #7d8896;
  }
  @media (min-width: 760px) {
    .footer-bottom {
      grid-template-columns: 1fr auto 1fr;
      justify-items: stretch;
    }
    .footer-bottom > p:first-child {
      justify-self: start;
    }
    .footer-social {
      justify-self: center;
    }
    .footer-credit {
      justify-self: end;
      text-align: right;
    }
  }
  .footer-bottom p {
    margin: 0;
  }
  .footer-credit a {
    color: inherit;
    font-weight: inherit;
    text-decoration: none;
  }
  .footer-credit a:hover {
    color: inherit;
  }
  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }
  .footer-social a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #d8dee6;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .footer-social a:hover {
    color: var(--gold);
  }
  .footer-social svg {
    width: 18px;
    height: 18px;
    flex: none;
  }
</style>
