---
import ContactSection from "./ContactSection.astro";
import GoogleReviewsSection from "./GoogleReviewsSection.astro";
import MeetJackTrust from "./MeetJackTrust.astro";
import ServiceMap from "./ServiceMap.astro";

interface Benefit {
  title: string;
  body: string;
  icon: string;
}

interface WhyUsItem {
  title: string;
  body: string;
}

interface ProcessStep {
  step: string;
  title: string;
  body: string;
}

interface Faq {
  q: string;
  a: string;
}

interface Props {
  path: string;
  title: string;
  description: string;
  heroEyebrow: string;
  heroH1: string;
  heroLead: string;
  heroImage: string;
  heroImageAlt: string;
  whatIsTitle: string;
  whatIsLead: string;
  whatIsParagraphs: string[];
  whatIsImage: string;
  whatIsImageAlt: string;
  benefitsTitle: string;
  benefitsLead: string;
  benefits: Benefit[];
  coloursTitle?: string;
  coloursLead?: string;
  coloursParagraphs?: string[];
  whyUsTitle: string;
  whyUsLead: string;
  whyUs: WhyUsItem[];
  pricingTitle: string;
  pricingParagraphs: string[];
  pricingPoints: string[];
  process: ProcessStep[];
  faqs: Faq[];
  reviewsLead: string;
  meetJackLead: string;
  meetJackParagraphs: string[];
  relatedService?: { name: string; href: string; body: string };
}

const {
  heroEyebrow,
  heroH1,
  heroLead,
  heroImage,
  heroImageAlt,
  whatIsTitle,
  whatIsLead,
  whatIsParagraphs,
  whatIsImage,
  whatIsImageAlt,
  benefitsTitle,
  benefitsLead,
  benefits,
  coloursTitle,
  coloursLead,
  coloursParagraphs,
  whyUsTitle,
  whyUsLead,
  whyUs,
  pricingTitle,
  pricingParagraphs,
  pricingPoints,
  process,
  faqs,
  reviewsLead,
  meetJackLead,
  meetJackParagraphs,
  relatedService,
} = Astro.props;

const phone = "07707 564597";
const phoneHref = "tel:+447707564597";

const heroStats = [
  { value: "20", unit: "yrs", label: "In the rendering trade" },
  { value: "4", unit: "", label: "Manufacturer accreditations" },
];

const heroPoints = [
  "Manufacturer-trained, approved installer",
  "Fully insured for peace of mind",
  "Manufacturer-backed guarantees",
  "Free, no-obligation quotes",
];

const accreditations = [
  { name: "Baumit", note: "Approved Installer" },
  { name: "Weber", note: "Registered Applicator" },
  { name: "EcoRend", note: "Registered Contractor" },
  { name: "EWI", note: "Accredited Installer" },
];

const icons: Record<string, string> = {
  drop: '<path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0Z"/>',
  shield:
    '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/>',
  leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',
  sparkle:
    '<path d="m12 3-1.9 5.8H4.4l4.8 3.5-1.8 5.7L12 14.5l4.6 3.5-1.8-5.7 4.8-3.5H13.9Z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  layers: '<path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
};

const phoneIcon =
  '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/>';
---

<!-- Hero -->
<section class="service-hero">
  <div class="container service-hero-grid">
    <div class="service-hero-text">
      <p class="eyebrow hero-eyebrow">{heroEyebrow}</p>
      <h1>{heroH1}</h1>
      <p class="hero-sub">{heroLead}</p>
      <div class="hero-cta">
        <a class="btn" href="/contact">Get Your Free Quote</a>
        <a class="btn btn--light" href={phoneHref}>Call {phone}</a>
      </div>
      <ul class="hero-points">
        {heroPoints.map((p) => (
          <li>
            <span class="hero-check">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.check} />
            </span>
            {p}
          </li>
        ))}
      </ul>
    </div>
    <div class="service-hero-media">
      <img src={heroImage} alt={heroImageAlt} width="900" height="700" loading="eager" />
      <div class="hero-stats">
        {heroStats.map((s) => (
          <div class="hero-stat">
            <strong>{s.value}<span>{s.unit}</span></strong>
            <small>{s.label}</small>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Accreditations -->
<section class="section trust-strip">
  <div class="container">
    <p class="trust-label">Accredited and approved by the UK's leading render manufacturers</p>
    <ul class="badge-row">
      {accreditations.map((a) => (
        <li class="badge">
          <span class="badge-name">{a.name}</span>
          <span class="badge-note">{a.note}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- What is it -->
<section class="section" id="what-is">
  <div class="container split">
    <div class="split-text">
      <div class="section-head">
        <p class="eyebrow">What is it?</p>
        <h2>{whatIsTitle}</h2>
        <p class="lead">{whatIsLead}</p>
      </div>
      {whatIsParagraphs.map((p) => <p>{p}</p>)}
    </div>
    <div class="split-media">
      <img src={whatIsImage} alt={whatIsImageAlt} loading="lazy" width="900" height="700" />
    </div>
  </div>
</section>

<!-- Benefits -->
<section class="section section--sand">
  <div class="container">
    <div class="section-head center">
      <p class="eyebrow">Benefits</p>
      <h2>{benefitsTitle}</h2>
      <p class="lead">{benefitsLead}</p>
    </div>
    <div class="grid grid-2 benefits-grid">
      {benefits.map((b) => (
        <article class="card benefit-card">
          <span class="icon-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[b.icon]} />
          </span>
          <h3>{b.title}</h3>
          <p>{b.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<MeetJackTrust lead={meetJackLead} paragraphs={meetJackParagraphs} />

{coloursTitle && coloursParagraphs && (
  <section class="section" id="colours">
    <div class="container narrow">
      <div class="section-head center">
        <p class="eyebrow">Colour options</p>
        <h2>{coloursTitle}</h2>
        {coloursLead && <p class="lead">{coloursLead}</p>}
      </div>
      {coloursParagraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>
)}

<!-- Why choose us -->
<section class="section section--dark" id="why-us">
  <div class="container why-grid">
    <div class="why-intro">
      <p class="eyebrow">Why choose us</p>
      <h2>{whyUsTitle}</h2>
      <p class="lead">{whyUsLead}</p>
      <a class="btn btn--light" href="/contact">Get Your Free Quote</a>
    </div>
    <div class="why-cards">
      {whyUs.map((item) => (
        <article class="why-card">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Process -->
<section class="section">
  <div class="container">
    <div class="section-head center">
      <p class="eyebrow">Our process</p>
      <h2>How we work</h2>
      <p class="lead">
        From your first enquiry to the final walk-round, Jack leads every stage of
        the job personally.
      </p>
    </div>
    <div class="grid grid-2 process-grid">
      {process.map((step) => (
        <article class="card process-card">
          <span class="process-step">{step.step}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Pricing -->
<section class="section section--sand" id="pricing">
  <div class="container pricing-grid">
    <div class="pricing-copy">
      <div class="section-head">
        <p class="eyebrow">Pricing</p>
        <h2>{pricingTitle}</h2>
      </div>
      {pricingParagraphs.map((p) => <p>{p}</p>)}
      <a class="btn" href="/contact">Request a Free Quote</a>
    </div>
    <ul class="pricing-points card">
      {pricingPoints.map((point) => (
        <li>
          <span class="pricing-check">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons.check} />
          </span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- FAQ -->
<section class="section faq-section">
  <div class="container faq-wrap">
    <div class="section-head center">
      <p class="eyebrow">FAQs</p>
      <h2>Frequently asked questions</h2>
    </div>
    <div class="faq-list">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary>{faq.q}</summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<GoogleReviewsSection lead={reviewsLead} />

<ServiceMap />

<!-- Contact -->
<section class="section section--sand">
  <ContactSection />
</section>

{relatedService && (
  <section class="section">
    <div class="container">
      <article class="card related-card">
        <p class="eyebrow">Also offered</p>
        <h3>{relatedService.name}</h3>
        <p>{relatedService.body}</p>
        <a class="text-link" href={relatedService.href}>{relatedService.name} &rarr;</a>
      </article>
    </div>
  </section>
)}

<!-- Final CTA -->
<section class="final-cta">
  <div class="container final-inner">
    <p class="eyebrow">Free no-obligation quote</p>
    <h2>Ready to get started?</h2>
    <p class="lead">
      Contact Kent Render Systems today for a free survey and quote. Call us on
      {phone} or send a message through our contact form.
    </p>
    <div class="final-actions">
      <a class="btn btn--light" href="/contact">Get Your Free Quote</a>
      <a class="btn btn--on-dark btn--ghost" href={phoneHref}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={phoneIcon} />
        Call {phone}
      </a>
    </div>
  </div>
</section>

<style>
  .service-hero {
    background:
      radial-gradient(900px 420px at 85% 0%, rgba(30, 91, 184, 0.35), transparent 60%),
      linear-gradient(150deg, #15203b, #1d2c50);
    color: #e7ecf1;
    padding-block: clamp(56px, 6vw, 96px);
  }
  .service-hero-grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 920px) {
    .service-hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 56px;
    }
  }
  .hero-eyebrow {
    color: var(--gold);
  }
  .service-hero h1 {
    color: #fff;
    font-size: clamp(2.1rem, 1.3rem + 3vw, 3.2rem);
    max-width: 14ch;
  }
  .hero-sub {
    color: #c7d0da;
    max-width: 58ch;
    margin-bottom: 28px;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 28px;
  }
  .hero-cta .btn--light:hover {
    opacity: 0.88;
    background: #fff;
    border-color: #fff;
    color: var(--ink);
    transform: translateY(-1px);
  }
  .hero-points {
    display: grid;
    gap: 10px;
  }
  .hero-points li {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #dde4ec;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .hero-check {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    background: rgba(91, 143, 217, 0.2);
    color: var(--gold);
    flex: none;
  }
  .hero-check svg {
    width: 16px;
    height: 16px;
  }
  .service-hero-media {
    position: relative;
  }
  .service-hero-media img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .hero-stats {
    position: absolute;
    left: 20px;
    bottom: 20px;
    display: flex;
    gap: 12px;
  }
  .hero-stat {
    background: rgba(255, 255, 255, 0.96);
    border-radius: 12px;
    padding: 12px 16px;
    box-shadow: var(--shadow-md);
    text-align: center;
    min-width: 92px;
  }
  .hero-stat strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--ink);
    line-height: 1;
  }
  .hero-stat strong span {
    font-size: 0.9rem;
    margin-left: 2px;
  }
  .hero-stat small {
    display: block;
    margin-top: 4px;
    font-size: 0.72rem;
    color: var(--muted);
    line-height: 1.3;
  }

  .trust-strip {
    padding-block: 36px;
  }
  .trust-label {
    text-align: center;
    font-size: 0.88rem;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .badge-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px 18px;
  }
  .badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 12px 26px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--sand);
    min-width: 160px;
  }
  .badge-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--ink);
    letter-spacing: 0.02em;
  }
  .badge-note {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--terracotta-dark);
    font-weight: 600;
  }

  .split {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 880px) {
    .split {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
    }
  }
  .split-text p:last-child {
    margin-bottom: 0;
  }
  .split-media img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .benefit-card {
    display: grid;
    gap: 12px;
  }
  .benefit-card p {
    margin: 0;
    color: var(--ink-soft);
  }

  .narrow {
    max-width: 760px;
  }
  .narrow p:last-child {
    margin-bottom: 0;
  }

  .why-grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 920px) {
    .why-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 56px;
      align-items: start;
    }
    .why-intro {
      position: sticky;
      top: calc(var(--header-h) + 30px);
    }
  }
  .why-intro h2,
  .why-card h3 {
    color: #fff;
  }
  .why-intro .lead,
  .why-card p {
    color: #c7d0da;
  }
  .why-intro .eyebrow {
    color: var(--gold);
  }
  .why-cards {
    display: grid;
    gap: 16px;
  }
  .why-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    padding: 24px;
  }
  .why-card p {
    margin: 0;
  }

  .process-card {
    display: grid;
    gap: 10px;
  }
  .process-step {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    color: var(--terracotta-dark);
  }
  .process-card p {
    margin: 0;
    color: var(--ink-soft);
  }

  .pricing-grid {
    display: grid;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 880px) {
    .pricing-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 40px;
    }
  }
  .pricing-points {
    display: grid;
    gap: 16px;
    padding: 28px;
  }
  .pricing-points li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .pricing-check {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    background: var(--terracotta-soft);
    color: var(--terracotta-dark);
    flex: none;
  }
  .pricing-check svg {
    width: 18px;
    height: 18px;
  }

  .faq-section {
    background:
      radial-gradient(900px 420px at 85% 0%, rgba(30, 91, 184, 0.18), transparent 60%),
      linear-gradient(180deg, #eef3fa, #f8fafc);
  }
  .faq-wrap {
    max-width: 820px;
  }
  .faq-list {
    display: grid;
    gap: 12px;
  }
  .faq-item {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 18px 22px;
    box-shadow: var(--shadow-sm);
  }
  .faq-item summary {
    font-family: var(--font-display);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: "+";
    color: var(--terracotta);
    font-size: 1.3rem;
    line-height: 1;
  }
  .faq-item[open] summary::after {
    content: "−";
  }
  .faq-item p {
    margin: 14px 0 0;
    color: var(--ink-soft);
  }

  .related-card {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
    padding: 32px;
  }
  .related-card p:last-of-type {
    color: var(--ink-soft);
  }

  .final-cta {
    background:
      radial-gradient(900px 420px at 15% 0%, rgba(30, 91, 184, 0.42), transparent 60%),
      linear-gradient(150deg, #15203b, #1d2c50);
    color: #e7ecf1;
    padding-block: clamp(64px, 6vw, 110px);
    text-align: center;
  }
  .final-inner {
    max-width: 720px;
    margin-inline: auto;
  }
  .final-cta .eyebrow {
    color: var(--gold);
  }
  .final-cta h2 {
    color: #fff;
  }
  .final-cta .lead {
    color: #c7d0da;
    margin-bottom: 30px;
  }
  .final-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }
  .final-actions .btn svg {
    width: 18px;
    height: 18px;
  }
</style>
